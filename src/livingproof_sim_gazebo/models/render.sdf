<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="falling">
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><scene><ambient>0.7 0.7 0.7 1</ambient><background>0.2 0.3 0.4 1</background></scene><gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>0.01</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <model name="ball"><plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>true</publish_link_pose><update_frequency>100</update_frequency></plugin><pose>0 0 2 0 0 0</pose><link name="body"><inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual></link></model>
  <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.5 0 -1</direction><diffuse>1 1 1 1</diffuse></light>
    <model name="camera"><static>true</static><pose>-3 0 2 0 0 0</pose><link name="camera_link"><sensor name="camera" type="camera"><always_on>true</always_on><update_rate>10</update_rate><camera><horizontal_fov>1.0</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip><save enabled="true"><path>__FRAME_DIRECTORY__</path></save></camera></sensor></link></model>
  </world>
</sdf>
