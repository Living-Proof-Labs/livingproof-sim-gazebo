<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="falling">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <model name="ball"><plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>true</publish_link_pose><update_frequency>100</update_frequency></plugin><pose>0 0 2 0 0 0</pose><link name="body"><inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual></link></model>
  </world>
</sdf>
