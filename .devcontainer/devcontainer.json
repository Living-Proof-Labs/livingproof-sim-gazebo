{
  "name": "Gazebo development",
  "dockerComposeFile": "../compose.yaml",
  "service": "tooling",
  "workspaceFolder": "/workspace/gazebo",
  "remoteUser": "vscode",
  "overrideCommand": true,
  "initializeCommand": "mkdir -p .cache && cp \"${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}\" .cache/build-ca.pem && chmod 644 .cache/build-ca.pem",
  "postCreateCommand": "task setup"
}
