{
  "name": "Gazebo development",
  "dockerComposeFile": "../compose.yaml",
  "service": "tooling",
  "workspaceFolder": "/workspace/gazebo",
  "remoteUser": "vscode",
  "overrideCommand": true,
  "initializeCommand": "mkdir -p .build-secrets && cp \"${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}\" .build-secrets/ca.pem && chmod 644 .build-secrets/ca.pem",
  "postCreateCommand": "task setup"
}
